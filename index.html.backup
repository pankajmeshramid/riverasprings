      prodLabel:'\u0906\u092e\u091a\u0940 \u0930\u0947\u0902\u091c',prodH2:'\u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u092b\u0949\u0930\u094d\u092e\u0945\u091f,<br>\u090f\u0915\u091a \u0909\u0917\u092e<span class="gold-rule" style="margin-top:1rem"></span>',
      prodDesc:'\u0938\u0930\u094d\u0935 \u092c\u093e\u091f\u0932\u094d\u092f\u093e \u090f\u0915\u093e\u091a \u091d\u0930\u094d\u200d\u092f\u093e\u091a\u094d\u092f\u093e \u092a\u093e\u0923\u094d\u092f\u093e\u0924\u0942\u0928 \u092f\u0947\u0924\u093e\u0924 \u0906\u0923\u093f \u090f\u0915\u093e\u091a \u092e\u0932\u094d\u091f\u0940-\u0938\u094d\u091f\u0947\u091c \u0936\u0941\u0926\u094d\u0927\u0940\u0915\u0930\u0923\u093e\u0924\u0942\u0928 \u091c\u093e\u0924\u093e\u0924. \u092b\u0930\u0915 \u092b\u0915\u094d\u0924 \u092a\u0945\u0915\u091a\u093e.',
      p250name:'\u0915\u0949\u092e\u094d\u092a\u0945\u0915\u094d\u091f',p250use:'\u092b\u093f\u0930\u0924\u093e\u0928\u093e \u092d\u093e\u0930\u0940 \u0909\u0924\u094d\u0924\u092e. \u092c\u0945\u0917\u092e\u0927\u094d\u092f\u0947 \u0920\u0947\u0935\u093e, \u0915\u093e\u0909\u0902\u091f\u0930\u0935\u0930 \u0920\u0947\u0935\u093e, \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e\u093e\u0924 \u0935\u093e\u091f\u093e.',
      p500name:'\u090f\u0935\u094d\u0939\u0930\u0940\u0921\u0947',p500use:'\u0930\u094b\u091c\u091a\u0940 \u0917\u0930\u091c. \u0930\u093f\u091f\u0947\u0932 \u0915\u093e\u0909\u0902\u091f\u0930, \u0939\u094b\u091f\u0947\u0932 \u0906\u0923\u093f \u0926\u0948\u0928\u0902\u0926\u093f\u0928 \u0939\u093e\u092f\u0921\u094d\u0930\u0947\u0936\u0928.',
      p1Lname:'\u0938\u094d\u091f\u0945\u0902\u0921\u0930\u094d\u0921',p1Luse:'\u0918\u0930 \u0906\u0923\u093f \u0911\u092b\u093f\u0938\u0938\u093e\u0920\u0940. \u0930\u094b\u091c\u091a\u0947 \u0939\u093e\u092f\u0921\u094d\u0930\u0947\u0936\u0928, \u0915\u0941\u091f\u0941\u0902\u092c\u093e\u091a\u0947 \u091c\u0947\u0935\u0923 \u0906\u0923\u093f \u091c\u0928\u0930\u0932 \u091f\u094d\u0930\u0947\u0921.',
