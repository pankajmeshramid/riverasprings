      qualH2:'\u0909\u0917\u092e\u093e\u0935\u0930 \u091a\u093e\u091a\u0923\u0940, \u0932\u093e\u0907\u0928\u0935\u0930 \u091a\u093e\u091a\u0923\u0940, \u0921\u093f\u0938\u094d\u092a\u0945\u091a\u0906\u0927\u0940 \u091a\u093e\u091a\u0923\u0940',
      qualIntro:'\u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u092a\u094d\u0930\u094b\u0921\u0915\u094d\u0936\u0928 \u092c\u0945\u091a\u091a\u0947 \u0928\u092e\u0941\u0928\u0947 \u0918\u0947\u0924\u0932\u0947 \u091c\u093e\u0924\u0947 \u0906\u0923\u093f IS 14543:2016 \u091a\u094d\u092f\u093e \u092e\u093e\u0928\u0915\u093e\u0902\u0928\u0941\u0938\u093e\u0930 \u091a\u093e\u091a\u0923\u0940 \u0939\u094b\u0924\u0947. FSSAI \u0924\u092a\u093e\u0938\u0923\u0940\u0938\u093e\u0920\u0940 \u0930\u0947\u0915\u0949\u0930\u094d\u0921 \u0924\u092f\u093e\u0930 \u0920\u0947\u0935\u0932\u0947 \u091c\u093e\u0924\u093e\u0924.',
      qualSrcH:'\u0909\u0917\u092e',qualSrcP:'\u0938\u0924\u092a\u0941\u0921\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u092a\u093e\u092f\u0925\u094d\u092f\u093e\u091c\u0935\u0933\u091a\u0947 \u0928\u0948\u0938\u0930\u094d\u0917\u093f\u0915 \u091d\u0930\u0947. \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u0916\u0921\u0915\u093e\u0902\u0924\u0942\u0928 \u0917\u093e\u0933\u0942\u0928 \u0906\u0932\u0947\u0932\u0947 \u092a\u093e\u0923\u0940 \u091c\u0947 \u0938\u0902\u0924\u0941\u0932\u093f\u0924 \u0916\u0928\u093f\u091c \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0926\u0947\u0924\u0947 \u2014 Magnesium, Potassium, Sodium \u0906\u0923\u093f Calcium \u0928\u0948\u0938\u0930\u094d\u0917\u093f\u0915 \u092a\u094d\u0930\u092e\u093e\u0923\u093e\u0924. TDS 50\u2013120 ppm \u092e\u0927\u094d\u092f\u0947.',
      qualProcH:'\u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e',qualProcP:'\u092e\u0932\u094d\u091f\u0940-\u0938\u094d\u091f\u0947\u091c \u091f\u094d\u0930\u0940\u091f\u092e\u0947\u0902\u091f \u091c\u0938\u0947 \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0932\u0947\u092c\u0932\u0935\u0930 \u091b\u093e\u092a\u0932\u0947\u0932\u0947 \u0906\u0939\u0947: \u0935\u093e\u0933\u0942 \u0917\u093e\u0933\u0923\u0940, \u0915\u093e\u0930\u094d\u092c\u0928 \u0917\u093e\u0933\u0923\u0940, Reverse Osmosis, UV \u091f\u094d\u0930\u0940\u091f\u092e\u0947\u0902\u091f \u0906\u0923\u093f \u0913\u091d\u094b\u0928\u093e\u092f\u091d\u0947\u0936\u0928. \u092f\u0941\u0915\u094d\u0924 \u0916\u0928\u093f\u091c: Magnesium, Potassium \u0906\u0923\u093f Sodium. \u092a\u0942\u0930\u094d\u0923\u092a\u0923\u0947 \u0938\u094d\u0935\u092f\u0902\u091a\u0932\u093f\u0924 \u092c\u0949\u091f\u0932\u093f\u0902\u0917 \u0932\u093e\u0907\u0928 \u2014 \u0907\u0928\u091f\u0947\u0915\u092a\u093e\u0938\u0942\u0928 \u0938\u0940\u0932\u094d\u0921 \u0915\u0945\u092a\u092a\u0930\u094d\u092f\u0902\u0924 \u0915\u0941\u0920\u0932\u0940\u0939\u0940 \u092e\u0945\u0928\u094d\u092f\u0941\u0905\u0932 \u0939\u0945\u0902\u0921\u0932\u093f\u0902\u0917 \u0928\u093e\u0939\u0940.',
      qualCertH:'\u092a\u094d\u0930\u092e\u093e\u0923\u0928',qualCertP:'FSSAI \u0932\u093e\u092f\u0938\u0928\u094d\u0938 (\u0932\u093e\u092f\u0938\u0928\u094d\u0938 \u0915\u094d\u0930: 11526999000410). IS 14543 \u0905\u0928\u0941\u092a\u093e\u0932\u0928. ISO 22000 \u0916\u093e\u0926\u094d\u092f \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e\u092a\u0928. \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u092c\u093e\u091f\u0932\u0940\u0935\u0930 BIS \u092a\u094d\u0930\u092e\u093e\u0923\u0928 \u091a\u093f\u0928\u094d\u0939. \u0928\u093f\u0930\u094d\u092e\u093e\u0924\u093e \u0906\u0923\u093f \u0935\u093f\u092a\u0923\u0928\u0915\u0930\u094d\u0924\u093e: Maya International Exports, \u0917\u091f \u0915\u094d\u0930 407/1/B, \u091f\u093e\u0902\u0921\u093e, \u0924\u0939 \u0906\u0923\u093f \u091c\u093f\u0932\u094d\u0939\u093e \u0917\u094b\u0902\u0926\u093f\u092f\u093e, \u092e\u0939\u093e\u0930\u093e\u0937\u094d\u091f\u094d\u0930 441614.',
