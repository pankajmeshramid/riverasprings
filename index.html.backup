      srcP1:'\u0930\u093f\u0935\u0947\u0930\u093e \u0938\u094d\u092a\u094d\u0930\u093f\u0902\u0917\u094d\u0938 <strong>\u0938\u0924\u092a\u0941\u0921\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u092a\u093e\u092f\u0925\u094d\u092f\u093e\u091c\u0935\u0933</strong> \u0936\u0941\u0926\u094d\u0927 \u0906\u0923\u093f \u0905\u0938\u094d\u092a\u0930\u094d\u0936\u093f\u0924 \u0927\u092c\u0927\u092c\u094d\u092f\u093e \u0906\u0923\u093f \u0928\u0948\u0938\u0930\u094d\u0917\u093f\u0915 \u091d\u0930\u094d\u200d\u092f\u093e\u0902\u0924\u0942\u0928 \u092a\u093e\u0923\u0940 \u0918\u0947\u0924\u094b \u2014 \u0939\u091c\u093e\u0930\u094b \u0935\u0930\u094d\u0937\u093e\u0902\u091a\u094d\u092f\u093e \u0916\u0921\u0915\u093e\u0902\u0924\u0942\u0928 \u0917\u093e\u0933\u0942\u0928 \u0906\u0932\u0947\u0932\u0947 \u092a\u093e\u0923\u0940. <strong>Magnesium, Potassium \u0906\u0923\u093f Sodium</strong> \u0928\u0947 \u092d\u0930\u092a\u0942\u0930, \u092f\u093e \u092a\u093e\u0923\u094d\u092f\u093e\u0924 \u092d\u0942\u0935\u0948\u091c\u094d\u091e\u093e\u0928\u093f\u0915 \u0917\u093e\u0933\u0923\u0940\u0924\u0942\u0928\u091a \u092e\u093f\u0933\u0923\u093e\u0930\u0940 \u0938\u0902\u0924\u0941\u0932\u093f\u0924 \u0916\u0928\u093f\u091c \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0906\u0939\u0947.',
      srcP2:'\u0939\u0947 \u092e\u094d\u092f\u0941\u0928\u093f\u0938\u093f\u092a\u0932 \u091f\u094d\u0930\u0940\u091f\u0947\u0921 \u092a\u093e\u0923\u0940 \u0915\u093f\u0902\u0935\u093e \u092c\u094b\u0930\u0935\u0947\u0932 \u0938\u092a\u094d\u0932\u093e\u092f \u0928\u093e\u0939\u0940. \u0939\u0940 \u0928\u093f\u0938\u0930\u094d\u0917\u093e\u091a\u0940\u091a \u0917\u093e\u0933\u0923\u0940 \u0906\u0939\u0947, \u0909\u0917\u092e\u0938\u094d\u0925\u093e\u0928\u093e\u0935\u0930\u091a \u092c\u0949\u091f\u0932 \u0915\u0947\u0932\u0947\u0932\u0940. \u0906\u092e\u094d\u0939\u0940 \u091d\u0930\u094d\u200d\u092f\u093e\u092a\u093e\u0938\u0942\u0928 \u092a\u094d\u0932\u093e\u0902\u091f\u092a\u0930\u094d\u092f\u0902\u0924 \u092c\u0902\u0926 \u0938\u0930\u094d\u0915\u093f\u091f\u092e\u0927\u0947 \u092a\u093e\u0923\u0940 \u0906\u0923\u0924\u094b \u2014 \u091f\u0945\u0902\u0915\u0930 \u0928\u093e\u0939\u0940, \u0909\u0918\u0921\u094d\u092f\u093e\u0935\u0930 \u0938\u093e\u0920\u0935\u0923 \u0928\u093e\u0939\u0940. \u092c\u0949\u091f\u0932\u093f\u0902\u0917 \u092b\u0945\u0915\u094d\u091f\u094d\u0930\u0940 \u0909\u0917\u092e\u093e\u0935\u0930 \u0906\u0939\u0947, \u0915\u0941\u0920\u0932\u094d\u092f\u093e \u0907\u0902\u0921\u0938\u094d\u091f\u094d\u0930\u093f\u092f\u0932 \u090f\u0938\u094d\u091f\u0947\u091f\u092e\u0927\u0947 \u0928\u093e\u0939\u0940.',
