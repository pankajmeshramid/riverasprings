      fdrH2:'\u0906\u092a\u0932\u094d\u092f\u093e \u0932\u0947\u092c\u0932\u0932\u093e \u0928\u094d\u092f\u093e\u092f \u0926\u0947\u0923\u093e\u0930\u093e \u0935\u0949\u091f\u0930 \u092c\u094d\u0930\u093e\u0902\u0921 \u0924\u092f\u093e\u0930 \u0915\u0930\u0923\u0947',
      fdrP1:'\u0938\u094c\u0930\u092d \u0915\u0947 \u0905\u092e\u0917\u093e\u0935\u091a\u0947 \u090f\u0915 \u0924\u0930\u0941\u0923 \u0906\u0939\u0947\u0924 \u2014 \u092a\u0942\u0930\u094d\u0935 \u092e\u0939\u093e\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u093e\u0924\u0932\u094d\u092f\u093e \u0917\u094b\u0902\u0926\u093f\u092f\u093e \u091c\u093f\u0932\u094d\u0939\u094d\u092f\u093e\u0924\u0932\u0947 \u090f\u0915 \u0932\u0939\u093e\u0928 \u0917\u093e\u0935. \u092a\u093e\u0923\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u0927\u0902\u0926\u094d\u092f\u093e\u0924 \u091c\u0928\u094d\u092e \u0928\u093e\u0939\u0940 \u2014 \u0928\u0948\u0938\u0930\u094d\u0917\u093f\u0915 \u091d\u0930\u094d\u200d\u092f\u093e\u092a\u093e\u0938\u0942\u0928 \u0938\u094d\u0935\u092f\u0902\u091a\u0932\u093f\u0924 \u092c\u0949\u091f\u0932\u093f\u0902\u0917\u092a\u0930\u094d\u092f\u0902\u0924, BIS \u0905\u0928\u0941\u092a\u093e\u0932\u0928\u093e\u091a\u094d\u092f\u093e \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u093e\u092a\u093e\u0938\u0942\u0928 \u0932\u093e\u0938\u094d\u091f-\u092e\u093e\u0907\u0932 \u0935\u093f\u0924\u0930\u0923\u093e\u092a\u0930\u094d\u092f\u0902\u0924 \u2014 \u0938\u0930\u094d\u0935 \u0936\u0942\u0928\u094d\u092f\u093e\u092a\u093e\u0938\u0942\u0928 \u0936\u093f\u0915\u0932\u0947.',
      fdrP2:'\u0924\u094d\u092f\u093e \u092a\u093e\u0935\u0932\u093e\u091a\u0940 \u0938\u0941\u0930\u0941\u0935\u093e\u0924 \u090f\u0915\u093e \u0938\u094b\u092a\u094d\u092f\u093e \u091c\u093e\u0923\u093f\u0935\u0947\u0924\u0942\u0928 \u091d\u093e\u0932\u0940: \u0924\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u092d\u093e\u0917\u093e\u0932\u093e \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u092c\u094d\u0930\u093e\u0902\u0921\u094d\u0938\u091a\u094d\u092f\u093e \u0926\u0930\u094d\u091c\u093e\u091a\u0947 \u0938\u094d\u092a\u094d\u0930\u093f\u0902\u0917-\u0915\u094d\u0935\u093e\u0932\u093f\u091f\u0940 \u092a\u093e\u0923\u094d\u092f\u093e\u091a\u093e \u0939\u0915\u094d\u0915 \u0939\u094b\u0924\u093e, \u0915\u0941\u0920\u0932\u094d\u092f\u093e \u092c\u094b\u0930\u0935\u0947\u0932-RO \u0911\u092a\u0930\u0947\u0936\u0928 \u0928\u093e\u0939\u0940. \u0924\u094d\u092f\u093e\u0902\u0928\u0940 Maya International Exports \u091a\u0940 \u0938\u094d\u0925\u093e\u092a\u0928\u093e \u0915\u0947\u0932\u0940 \u0906\u0923\u093f \u0905\u092e\u0917\u093e\u0935\u091c\u0935\u0933 \u0930\u093f\u0935\u0947\u0930\u093e \u0938\u094d\u092a\u094d\u0930\u093f\u0902\u0917\u094d\u0938 \u092c\u0949\u091f\u0932\u093f\u0902\u0917 \u0932\u093e\u0907\u0928 \u0932\u093e\u0935\u0932\u0940 \u2014 \u091c\u093e\u0923\u0942\u0928\u092c\u0941\u091c\u0942\u0928 \u092c\u093e\u091c\u093e\u0930\u093e\u091c\u0935\u0933 \u0928\u093e\u0939\u0940, \u0909\u0917\u092e\u093e\u091c\u0935\u0933.',
      fdrP3:'\u0924\u094d\u092f\u093e\u0902\u0928\u093e \u091a\u093e\u0932\u0935\u0923\u093e\u0930\u0940 \u0917\u094b\u0937\u094d\u091f \u092e\u094d\u0939\u0923\u091c\u0947 \u092a\u093e\u0923\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u0917\u0941\u0923\u0935\u0924\u094d\u0924\u0947\u092c\u0926\u094d\u0926\u0932\u091a\u0940 \u091d\u092a\u093e\u091f\u0923\u0940 \u091c\u0940 \u0928\u0941\u0938\u0924\u094d\u092f\u093e \u0905\u0928\u0941\u092a\u093e\u0932\u0928\u093e\u092a\u0932\u0940\u0915\u0921\u0947 \u091c\u093e\u0924\u0947 \u2014 \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u092c\u0945\u091a \u091f\u0947\u0938\u094d\u091f\u0947\u0921, \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0909\u0917\u092e \u092e\u0949\u0928\u093f\u091f\u0930\u094d\u0921, \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0935\u093f\u091a\u0932\u0928\u093e\u091a\u0940 \u091a\u094c\u0915\u0936\u0940. \u0909\u0926\u094d\u0926\u0947\u0936 \u0938\u094d\u092a\u0937\u094d\u091f \u0906\u0939\u0947: \u0930\u093f\u0935\u0947\u0930\u093e \u0938\u094d\u092a\u094d\u0930\u093f\u0902\u0917\u094d\u0938 \u0932\u093e \u0935\u093f\u0926\u0930\u094d\u092d \u0906\u0923\u093f \u0938\u092e\u0938\u094d\u0924 \u092e\u0939\u093e\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u093e\u091a\u093e \u092d\u0930\u0935\u0936\u093e\u091a\u093e \u092c\u094d\u0930\u093e\u0902\u0921 \u092c\u0928\u0935\u0923\u0947. \u0936\u0947\u0932\u094d\u092b\u0935\u0930\u091a\u093e \u0938\u094d\u0935\u0938\u094d\u0924\u093e\u0924\u0932\u093e \u092a\u0930\u094d\u092f\u093e\u092f \u0928\u093e\u0939\u0940, \u0938\u0930\u094d\u0935\u093e\u0924 \u0938\u094d\u0935\u091a\u094d\u091b \u092a\u0930\u094d\u092f\u093e\u092f.',
      fdrQuote:'\u201c[\u0938\u0902\u0938\u094d\u0925\u093e\u092a\u0915\u093e\u091a\u0947 \u0935\u093f\u0927\u093e\u0928 \u2014 \u0928\u0902\u0924\u0930 \u091c\u094b\u0921\u0932\u0947 \u091c\u093e\u0908\u0932]\u201d',fdrCite:'\u0938\u094c\u0930\u092d \u0915\u0947, \u0938\u0902\u0938\u094d\u0925\u093e\u092a\u0915',
      factLabel:'\u0906\u092e\u091a\u0940 \u0938\u0941\u0935\u093f\u0927\u093e',factH2:'\u091c\u093f\u0925\u0947 \u0928\u093f\u0938\u0930\u094d\u0917 \u0906\u0923\u093f \u0924\u0902\u0924\u094d\u0930\u091c\u094d\u091e\u093e\u0928 \u092d\u0947\u091f\u0924\u0947',
      factDesc:'\u091f\u093e\u0902\u0921\u093e, \u091c\u093f\u0932\u094d\u0939\u093e \u0917\u094b\u0902\u0926\u093f\u092f\u093e \u092f\u0947\u0925\u0947 \u0906\u092e\u091a\u0940 \u0938\u0941\u0935\u093f\u0927\u093e \u092a\u0942\u0930\u094d\u0923\u092a\u0923\u0947 \u0938\u094d\u0935\u092f\u0902\u091a\u0932\u093f\u0924 \u092c\u0949\u091f\u0932\u093f\u0902\u0917 \u0932\u093e\u0907\u0928\u0928\u0947 \u0938\u091c\u094d\u091c \u0906\u0939\u0947 \u2014 90 \u092c\u093e\u091f\u0932\u094d\u092f\u093e \u092a\u094d\u0930\u0924\u093f \u092e\u093f\u0928\u093f\u091f, 4-5 \u092c\u0949\u0915\u094d\u0938 \u092a\u094d\u0930\u0924\u093f \u092e\u093f\u0928\u093f\u091f. \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u092c\u093e\u091f\u0932\u0940 BIS \u0906\u0923\u093f ISO \u092e\u093e\u0928\u0915\u093e\u0902\u0928\u0941\u0938\u093e\u0930 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u093f\u0924 \u0938\u094d\u0935\u091a\u094d\u091b\u0924\u093e \u0935\u093e\u0924\u093e\u0935\u0930\u0923\u093e\u0924 \u0938\u0940\u0932 \u0939\u094b\u0924\u0947.',
      retLabel:'\u092d\u093e\u0917\u0940\u0926\u093e\u0930 \u0935\u094d\u0939\u093e',retH2:'\u0930\u093f\u091f\u0947\u0932\u0930\u094d\u0938 \u2014 \u0935\u093f\u0915\u093e \u0906\u0923\u093f \u0915\u092e\u0935\u093e',
      retIntro:'\u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u092c\u0949\u0915\u094d\u0938\u0935\u0930\u091a\u093e QR \u0915\u094b\u0921 \u0938\u094d\u0915\u0945\u0928 \u0915\u0930\u093e, \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0938\u094d\u0915\u0945\u0928\u0932\u093e 1 \u0915\u094d\u0930\u0947\u0921\u093f\u091f \u092a\u0949\u0907\u0902\u091f \u092e\u093f\u0933\u0935\u093e. 30 \u092a\u0949\u0907\u0902\u091f\u094d\u0938 \u091c\u092e\u093e \u0915\u0930\u093e \u0906\u0923\u093f 1 \u092e\u094b\u092b\u0924 \u092c\u0949\u0915\u094d\u0938 \u092e\u093f\u0933\u0935\u093e \u2014 30 \u0926\u093f\u0935\u0938\u093e\u0902\u0928\u0902\u0924\u0930 \u0909\u092a\u0932\u092c\u094d\u0927.',
      retStep1H:'QR \u0938\u094d\u0915\u0945\u0928 \u0915\u0930\u093e',retStep1P:'\u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092b\u094b\u0928\u0928\u0947 \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0930\u093f\u0935\u0947\u0930\u093e \u0938\u094d\u092a\u094d\u0930\u093f\u0902\u0917\u094d\u0938 \u092c\u0949\u0915\u094d\u0938\u0906\u0924\u0932\u093e QR \u0915\u094b\u0921 \u0938\u094d\u0915\u0945\u0928 \u0915\u0930\u093e.',
      retStep2H:'\u092a\u0949\u0907\u0902\u091f \u092e\u093f\u0933\u0935\u093e',retStep2P:'\u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0938\u094d\u0915\u0945\u0928\u0932\u093e 1 \u0915\u094d\u0930\u0947\u0921\u093f\u091f \u092a\u0949\u0907\u0902\u091f \u092e\u093f\u0933\u0924\u094b. \u092a\u0949\u0907\u0902\u091f\u094d\u0938 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0905\u0915\u093e\u0909\u0902\u091f\u092e\u0927\u094d\u092f\u0947 \u0906\u092a\u094b\u0906\u092a \u091c\u092e\u093e \u0939\u094b\u0924\u093e\u0924.',
      retStep3H:'\u092c\u0915\u094d\u0937\u0940\u0938 \u092e\u093f\u0933\u0935\u093e',retStep3P:'30 \u092a\u0949\u0907\u0902\u091f\u094d\u0938 \u091c\u092e\u093e \u0915\u0930\u093e \u0906\u0923\u093f 1 \u092e\u094b\u092b\u0924 \u092c\u0949\u0915\u094d\u0938 \u092e\u093f\u0933\u0935\u093e. 30 \u0926\u093f\u0935\u0938\u093e\u0902\u0928\u0902\u0924\u0930 \u0930\u093f\u0921\u0940\u092e \u0915\u0930\u0924\u093e \u092f\u0947\u0924\u094b.',
      retCta:'\u092d\u093e\u0917\u0940\u0926\u093e\u0930 \u0935\u094d\u0939\u093e',retComingSoon:'\u0932\u0935\u0915\u0930\u091a \u092f\u0947\u0924 \u0906\u0939\u0947',retLaunchMsg:'\u0906\u092e\u091a\u093e \u0930\u093f\u091f\u0947\u0932\u0930 \u0930\u093f\u0935\u0949\u0930\u094d\u0921 \u092a\u094d\u0930\u094b\u0917\u094d\u0930\u093e\u092e \u0932\u0935\u0915\u0930\u091a \u0938\u0941\u0930\u0942 \u0939\u094b\u0924 \u0906\u0939\u0947. \u0906\u091c\u091a \u0924\u0941\u092e\u091a\u0940 \u0906\u0935\u0921 \u0928\u094b\u0902\u0926\u0935\u093e \u0906\u0923\u093f \u0938\u0930\u094d\u0935\u092a\u094d\u0930\u0925\u092e \u0915\u092e\u0935\u093e.',
      distLabel:'\u0906\u092e\u091a\u0947 \u0928\u0947\u091f\u0935\u0930\u094d\u0915',distH2Text:'\u0906\u092e\u091a\u0947 \u0905\u092d\u093f\u092e\u093e\u0928\u093e\u091a\u0947 \u0935\u093f\u0924\u0930\u0915',
      distTopBadge:'\u2b50 \u091f\u0949\u092a \u0938\u0947\u0932\u0930',distTopName:'[\u091f\u0949\u092a \u0935\u093f\u0924\u0930\u0915\u093e\u091a\u0947 \u0928\u093e\u0935]',distTopRegion:'[\u092a\u094d\u0930\u0926\u0947\u0936]',
      dist1Name:'[\u0935\u093f\u0924\u0930\u0915 1]',dist1City:'[\u0936\u0939\u0930]',dist2Name:'[\u0935\u093f\u0924\u0930\u0915 2]',dist2City:'[\u0936\u0939\u0930]',
      dist3Name:'[\u0935\u093f\u0924\u0930\u0915 3]',dist3City:'[\u0936\u0939\u0930]',dist4Name:'[\u0935\u093f\u0924\u0930\u0915 4]',dist4City:'[\u0936\u0939\u0930]',
      dist5Name:'[\u0935\u093f\u0924\u0930\u0915 5]',dist5City:'[\u0936\u0939\u0930]',dist6Name:'[\u0935\u093f\u0924\u0930\u0915 6]',dist6City:'[\u0936\u0939\u0930]',
      ctLabel:'\u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u093e',ctH2:'\u0906\u092e\u091a\u094d\u092f\u093e\u0936\u0940 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u093e',
      ctCompany:'\u0930\u093f\u0935\u0947\u0930\u093e \u0938\u094d\u092a\u094d\u0930\u093f\u0902\u0917\u094d\u0938',ctBrand:'(Maya International Exports \u091a\u093e \u092c\u094d\u0930\u093e\u0902\u0921)',
      ctAddress:'\u0917\u091f \u0915\u094d\u0930 407/1/B \u091f\u093e\u0902\u0921\u093e, \u0924\u0939 \u0906\u0923\u093f \u091c\u093f\u0932\u094d\u0939\u093e \u0917\u094b\u0902\u0926\u093f\u092f\u093e, \u092e\u0939\u093e\u0930\u093e\u0937\u094d\u091f\u094d\u0930-441614',
      ctPhoneLabel:'\u092b\u094b\u0928:',ctEmailLabel:'\u0908\u092e\u0947\u0932:',
      ctNameLabel:'\u0928\u093e\u0935',ctNamePh:'\u0924\u0941\u092e\u091a\u0947 \u0928\u093e\u0935',ctPhoneFLabel:'\u092b\u094b\u0928',ctPhonePh:'\u0924\u0941\u092e\u091a\u093e \u092b\u094b\u0928 \u0928\u0902\u092c\u0930',
      ctMsgLabel:'\u0938\u0902\u0926\u0947\u0936',ctMsgPh:'\u0906\u092e\u094d\u0939\u0940 \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0915\u0938\u0940 \u092e\u0926\u0924 \u0915\u0930\u0942?',ctSubmit:'\u0938\u0902\u0926\u0947\u0936 \u092a\u093e\u0920\u0935\u093e',
      footerText:'\u00a9 2024 \u0930\u093f\u0935\u0947\u0930\u093e \u0938\u094d\u092a\u094d\u0930\u093f\u0902\u0917\u094d\u0938. \u0938\u0930\u094d\u0935 \u0939\u0915\u094d\u0915 \u0930\u093e\u0916\u0940\u0935. | \u0905\u092e\u0917\u093e\u0935, \u092e\u0939\u093e\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u093e\u0924 \u0905\u092d\u093f\u092e\u093e\u0928\u093e\u0928\u0947 \u092c\u0928\u0935\u0932\u0947\u0932\u0947',
      upcomingEyebrow:'\u092a\u0941\u0922\u0947 \u0915\u093e\u092f',upcomingTitle:'\u0906\u0917\u093e\u092e\u0940 \u0909\u0924\u094d\u092a\u093e\u0926\u0928\u0947',upcomingSubtitle:'\u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0939\u093e\u092f\u0921\u094d\u0930\u0947\u0936\u0928\u0938\u0939 \u0906\u092e\u091a\u094d\u092f\u093e \u0930\u0947\u0902\u091c\u091a\u093e \u0935\u093f\u0938\u094d\u0924\u093e\u0930 \u2014 \u091c\u094d\u092f\u093e\u0902\u0928\u093e \u0924\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u092a\u093e\u0923\u094d\u092f\u093e\u0915\u0921\u0942\u0928 \u0905\u0927\u093f\u0915\u093e\u091a\u0940 \u0905\u092a\u0947\u0915\u094d\u0937\u093e \u0906\u0939\u0947.',
      sparklingBadge:'\u0932\u0935\u0915\u0930\u091a \u092f\u0947\u0924 \u0906\u0939\u0947',sparklingTitle:'\u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0938\u094d\u092a\u093e\u0930\u094d\u0915\u0932\u093f\u0902\u0917 \u0935\u0949\u091f\u0930',sparklingDesc:'\u0928\u0948\u0938\u0930\u094d\u0917\u093f\u0915\u0930\u093f\u0924\u094d\u092f\u093e \u0915\u093e\u0930\u094d\u092c\u094b\u0928\u0947\u091f\u0947\u0921. \u0938\u0942\u0915\u094d\u0937\u094d\u092e \u092c\u0941\u0926\u092c\u0941\u0926\u0947. \u0924\u0947\u091a \u0936\u0941\u0926\u094d\u0927 \u0938\u0924\u092a\u0941\u0921\u094d\u092f\u093e\u091a\u0947 \u092a\u093e\u0923\u0940, \u0906\u0924\u093e \u091a\u092e\u0915\u0926\u093e\u0930 \u2014 \u091c\u094d\u092f\u093e\u0902\u0928\u093e \u0924\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u0936\u0941\u0926\u094d\u0927\u0924\u0947\u0924 \u091a\u092e\u0915 \u0939\u0935\u0940 \u0906\u0939\u0947.',
      alkalineBadge:'\u0932\u0935\u0915\u0930\u091a \u092f\u0947\u0924 \u0906\u0939\u0947',alkalineTitle:'\u0905\u0932\u094d\u0915\u0932\u093e\u0907\u0928 \u092e\u093f\u0928\u0930\u0932 \u0935\u0949\u091f\u0930',alkalineDesc:'\u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u0916\u0928\u093f\u091c\u093e\u0902\u0938\u0939. pH 9.5+. \u0938\u0915\u094d\u0930\u093f\u092f \u091c\u0940\u0935\u0928\u0936\u0948\u0932\u0940 \u0906\u0923\u093f \u0906\u0930\u094b\u0917\u094d\u092f\u0938\u091c\u0917 \u0917\u094d\u0930\u093e\u0939\u0915\u093e\u0902\u0938\u093e\u0920\u0940 \u2014 \u0928\u093f\u0938\u0930\u094d\u0917\u093e\u0924\u0942\u0928 \u0915\u094d\u0937\u093e\u0930\u0940\u092f \u0939\u093e\u092f\u0921\u094d\u0930\u0947\u0936\u0928, \u0932\u0945\u092c\u092e\u0927\u0942\u0928 \u0928\u093e\u0939\u0940.'
    }
  };

  function setLang(lang){
    var t=translations[lang];
    if(!t)return;
    document.documentElement.lang=lang;
    document.querySelectorAll('[data-i18n]').forEach(function(el){
      var key=el.getAttribute('data-i18n');
      if(t[key]!==undefined){
        if(el.getAttribute('data-i18n-html')==='true'){
          el.innerHTML=t[key];
        }else{
          el.innerHTML=t[key];
        }
      }
    });
    document.querySelectorAll('[data-i18n-placeholder]').forEach(function(el){
      var key=el.getAttribute('data-i18n-placeholder');
      if(t[key]!==undefined) el.placeholder=t[key];
    });
    document.querySelectorAll('.lang-btn').forEach(function(b){
      b.classList.toggle('active',b.getAttribute('data-lang')===lang);
    });
    try{localStorage.setItem('rv-lang',lang)}catch(e){}
  }

  document.querySelectorAll('.lang-btn').forEach(function(b){
    b.addEventListener('click',function(){setLang(this.getAttribute('data-lang'))});
  });

  /* Restore lang on load */
  var saved;
  try{saved=localStorage.getItem('rv-lang')}catch(e){}
  if(saved&&translations[saved]){setLang(saved)}

  /* Re-observe new rv elements (added sections) */
  if(!rm){
    var newReveals=document.querySelectorAll('.rv:not(.vis)');
    if(newReveals.length&&typeof obs!=='undefined'){
      newReveals.forEach(function(el){obs.observe(el)});
    }
  }


})();
</script>
</body>
</html>